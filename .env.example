# Browser-safe public key, from your Clerk application.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
VITE_RELAY_URL=ws://127.0.0.1:8787

# Server-only: use the same Clerk application as the browser.
CLERK_SECRET_KEY=sk_test_REPLACE_ME
# Exact issuer from your Clerk session token (your instance URL).
CLERK_ISSUER=https://YOUR-INSTANCE.clerk.accounts.dev
RELAY_ALLOWED_ORIGINS=http://localhost:5173
